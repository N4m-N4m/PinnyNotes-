<Window x:Class="PinnyNotes.WpfUi.Views.ConfirmDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pinny Notes"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleTextBlock"
                   Grid.Row="0"
                   Text="Delete note?"
                   FontFamily="Segoe UI Variable Display, Segoe UI"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

        <TextBlock x:Name="MessageTextBlock"
                   Grid.Row="1"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Text="This note will be permanently deleted. This can't be undone."
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <CheckBox x:Name="DontAskAgainCheckBox"
                  Grid.Row="2"
                  Margin="0,16,0,0"
                  Content="Don't ask me again" />

        <StackPanel Grid.Row="3"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button x:Name="DeleteButton"
                    MinWidth="96"
                    Content="Delete"
                    IsDefault="True"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button x:Name="CancelButton"
                    MinWidth="96"
                    Margin="8,0,0,0"
                    Content="Cancel"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
